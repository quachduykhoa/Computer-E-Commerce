@model ContactModel

@if (Model != null)
{
<div class="row">
	
		<div class="col-sm-2">
			<div class="companyinfo">
			<p> <img src="~/media/logo/@Model.LogoImg" width="120px" height="150px" /> </p>
			<p>@Html.Raw(@Model.Description)</p>
			</div>
		</div>
		<div class="col-sm-7">
			<div class="col-sm-5">
			<p>@Html.Raw(@Model.Map)</p>
				
			</div>

			
		</div>
		<div class="col-sm-3">
			<div class="address">
				<h5>Name : @Model.Name</h5>
				<h5>Email : @Model.Email</h5>
				<h5>Phone : @Model.Phone</h5>
			</div>
		</div>
	
</div>
}