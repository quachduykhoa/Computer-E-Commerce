@{
	int index = 0;
}
<style>
	.col-sm-12 img {
		width: 100%; /* full chiều ngang container */
		height: auto; /* tự tính chiều cao theo tỷ lệ gốc */
		object-fit: contain; /* hiển thị đủ ảnh, không crop */
	}


</style>
<section id="slider">
	<!--slider-->
	<div class="container">
		<div class="row">
			<div class="col-sm-12">
				<div id="slider-carousel" class="carousel slide" data-ride="carousel">
					<ol class="carousel-indicators">
						<li data-target="#slider-carousel" data-slide-to="0" class="active"></li>
						<li data-target="#slider-carousel" data-slide-to="1"></li>
						<li data-target="#slider-carousel" data-slide-to="2"></li>
					</ol>

					<div class="carousel-inner">



						@foreach (var slider in ViewBag.Silders)
						{
							<div class="item @(index == 0 ? "active" : "")">

								<div class="col-sm-12">
									<img src="~/media/sliders/@slider.Image" class="girl img-responsive" alt="" />

								</div>
							</div>
							index++;
						}




					</div>

					<a href="#slider-carousel" class="left control-carousel hidden-xs" data-slide="prev">
						<i class="fa fa-angle-left"></i>
					</a>
					<a href="#slider-carousel" class="right control-carousel hidden-xs" data-slide="next">
						<i class="fa fa-angle-right"></i>
					</a>
				</div>

			</div>
		</div>
	</div>
</section><!--/slider-->